{
  "name": "pi-shared-prompt-history",
  "version": "0.1.0",
  "description": "Snapshot shared interactive prompt history when Pi sessions start.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "history"
  ],
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test *.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "brace-expansion": "5.0.12",
      "undici": "8.12.3"
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.0",
    "@earendil-works/pi-tui": "0.99.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
